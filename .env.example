# Set to false for real dynamic social media analytics
DEMO_MODE=false

# Database connection: Use PostgreSQL (recommended) or SQLite local persistence
# PostgreSQL example: postgresql://updates:updates_password@localhost:5432/updates
DATABASE_URL=sqlite:///./updates.db

# Production CORS origins
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://127.0.0.1:3001

# Production API URL
NEXT_PUBLIC_API_URL=http://localhost:8000

# Streaming / Message Queue Layer (Apache Kafka)
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_ENABLED=true

# Twitter / X API v2 Credentials
TWITTER_API_KEY=
TWITTER_API_SECRET=
X_BEARER_TOKEN=

# Reddit API Credentials
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=UPDATES-Intelligence/1.0

# Telegram Credentials
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNELS=news,worldnews,india

# YouTube Data API v3 Key
YOUTUBE_API_KEY=

# Meta Facebook & Instagram Access Tokens
FACEBOOK_PAGE_ACCESS_TOKEN=
INSTAGRAM_ACCESS_TOKEN=
META_GRAPH_VERSION=v25.0

# NLP & Machine Learning Settings
LLM_PROVIDER=rag
SENTIMENT_PROVIDER=auto
HF_TOKEN=
HF_SENTIMENT_MODEL=airzipm/sentiment-analysis-muril-v2
HF_INFERENCE_ENDPOINT_URL=
HF_SAFETY_MODEL=Hate-speech-CNERG/indic-abusive-allInOne-MuRIL
SAFETY_PROVIDER=auto
SARCASM_MODEL=helinivan/english-sarcasm-detector
MODEL_DEVICE=cpu
HF_MODEL_CACHE=./.hf-cache

# CSQE Signal Qualification Engine Threshold (0.0 - 1.0)
CSQE_MIN_THRESHOLD=0.35

