# Copy this file to backend/.env. Never expose these values to NEXT_PUBLIC_* variables.
ADMIN_API_KEY=
ALLOW_UNAUTHENTICATED_LOCAL_MUTATIONS=true
PRIVACY_HASH_SECRET=
MAX_REQUEST_BYTES=1000000
API_RATE_LIMIT_PER_MINUTE=240
EXPENSIVE_RATE_LIMIT_PER_MINUTE=30
X_BEARER_TOKEN=
YOUTUBE_API_KEY=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=UPDATES-Intelligence/1.0
FACEBOOK_PAGE_ACCESS_TOKEN=
INSTAGRAM_ACCESS_TOKEN=

# Meta APIs require IDs belonging to authorised Page/professional-account content.
FACEBOOK_POST_IDS=
INSTAGRAM_MEDIA_IDS=
META_GRAPH_VERSION=v25.0

# Turn this on only after at least one connector above is configured.
AUTO_INGESTION_ENABLED=false
AUTO_INGESTION_INTERVAL_MINUTES=120
AUTO_INGESTION_PLATFORMS=x,youtube,reddit,facebook,instagram
AUTO_INGESTION_MAX_TOPICS=100
AUTO_INGESTION_MAX_ITEMS_PER_PLATFORM=100

# Discover news continuously; every imported story is analysed immediately.
AUTO_NEWS_REFRESH_ENABLED=true
AUTO_NEWS_REFRESH_INTERVAL_MINUTES=5
AUTO_NEWS_REFRESH_MAX_ITEMS=12
PUBLIC_SIGNAL_BATCH_SIZE=100
PUBLIC_SIGNAL_WORKERS=2
ANALYSIS_REFRESH_INTERVAL_MINUTES=120
CONTINUOUS_LEARNING_ENABLED=true
CONTINUOUS_LEARNING_INTERVAL_MINUTES=60
LEARNING_MIN_LABELS=60

# Local multilingual models (already installed by this project).
SENTIMENT_PROVIDER=auto
SAFETY_PROVIDER=auto
SARCASM_INFERENCE_ENDPOINT_URL=
SARCASM_MODEL_NAME=not-configured

# Optional Kafka streaming. The application keeps its proven direct pipeline
# unless this is explicitly enabled and the broker health check succeeds.
KAFKA_ENABLED=false
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_SECURITY_PROTOCOL=PLAINTEXT
KAFKA_SASL_MECHANISM=PLAIN
KAFKA_SASL_USERNAME=
KAFKA_SASL_PASSWORD=
KAFKA_CLIENT_ID=updates-intelligence
KAFKA_RAW_TOPIC=social-media-raw
KAFKA_NORMALIZED_TOPIC=social-media-normalized
KAFKA_QUALIFIED_TOPIC=social-media-qualified
KAFKA_DEAD_LETTER_TOPIC=social-media-dead-letter
HF_SENTIMENT_MODEL=airzipm/sentiment-analysis-muril-v2
HF_ALLOW_MODEL_DOWNLOAD=false
HF_SAFETY_MODEL=Hate-speech-CNERG/indic-abusive-allInOne-MuRIL
