# Copy this file to backend/.env. Never expose these values to NEXT_PUBLIC_* variables.
X_BEARER_TOKEN=
YOUTUBE_API_KEY=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=UPDATES-Intelligence/1.0
FACEBOOK_PAGE_ACCESS_TOKEN=
INSTAGRAM_ACCESS_TOKEN=

# Meta APIs require IDs belonging to authorised Page/professional-account content.
FACEBOOK_POST_IDS=
INSTAGRAM_MEDIA_IDS=
META_GRAPH_VERSION=v25.0

# Turn this on only after at least one connector above is configured.
AUTO_INGESTION_ENABLED=false
AUTO_INGESTION_INTERVAL_MINUTES=30
AUTO_INGESTION_PLATFORMS=x,youtube,reddit,facebook,instagram
AUTO_INGESTION_MAX_TOPICS=8
AUTO_INGESTION_MAX_ITEMS_PER_PLATFORM=100

# Local multilingual models (already installed by this project).
SENTIMENT_PROVIDER=auto
SAFETY_PROVIDER=auto
HF_SENTIMENT_MODEL=airzipm/sentiment-analysis-muril-v2
HF_SAFETY_MODEL=Hate-speech-CNERG/indic-abusive-allInOne-MuRIL
